{
  "name": "missile-defense-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "tsx scripts/dev-full.ts",
    "db:start": "tsx scripts/dev-db.ts",
    "server": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "user:reset-password": "tsx scripts/reset-password.ts",
    "build:geography": "tsx scripts/build-geography.ts",
    "desktop:build": "tsx scripts/build-desktop.ts",
    "desktop:dir": "tsx scripts/build-desktop.ts && electron-builder --dir",
    "desktop:dist": "tsx scripts/build-desktop.ts && electron-builder"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-simplify": "3.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "0.21.5",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "topojson-client": "3.1.0",
    "topojson-simplify": "3.0.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "world-atlas": "2.0.2"
  }
}
